# Set these in Vercel → Project → Settings → Environment Variables. Never in frontend code.

# Required
MODEL_API_KEY=your-meta-model-api-key

# Models (optional)
META_MODEL=muse-spark-1.3              # default
META_FALLBACK_MODEL=muse-spark-1.1     # used only if META_MODEL is unavailable; set empty to disable
META_ASR_MODEL=muse-voice-transcribe-1.0
META_BASE_URL=https://api.meta.ai/v1

# Abuse protection (optional but recommended)
# Shared rate limits across all server instances. Create a free Upstash Redis database
# (Vercel Marketplace → Upstash) and its two variables are added for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra origins allowed to call the API (your custom domain is detected automatically)
ALLOWED_ORIGINS=
# Production requires a browser Origin, or the Android app's X-Sada-Client header (identification, not a secret).
# Leave unset. "false" would accept requests with neither (not recommended).
REQUIRE_ORIGIN=
# Per-IP limits and whole-app daily ceiling
RL_AI_PER_MIN=20
RL_AI_PER_DAY=400
RL_EXERCISES_PER_HOUR=20
RL_ASR_PER_MIN=12
RL_ASR_PER_DAY=300
RL_PING_PER_MIN=3
GLOBAL_DAILY_CAP=5000
# Random string used to hash IPs into Meta's safety_identifier
SAFETY_ID_SALT=change-me
